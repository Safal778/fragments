{
  "name": "fragments",
  "private": true,
  "version": "0.0.1",
  "description": "Fragments back-end API",
  "scripts": {
    "test:watch": "jest -c jest.config.js --runInBand --watch",
    "test": "jest -c jest.config.js --runInBand",
    "coverage": "jest -c jest.config.js --runInBand --coverage",
    "lint": "eslint \"./src/**/*.js\" \"tests/**/*.js\"",
    "format": "prettier --write \"src/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.mjs\" \"*.json\" \"*.md\" \".prettierrc\" \".github/**/*.yml\"",
    "format:check": "prettier --check \"src/**/*.js\" \"tests/**/*.js\" \"*.js\" \"*.mjs\" \"*.json\" \"*.md\" \".prettierrc\" \".github/**/*.yml\"",
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "debug": "node --inspect=127.0.0.1:9229 src/index.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Safal778/fragments.git"
  },
  "author": "Safal",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=20.6.0"
  },
  "dependencies": {
    "aws-jwt-verify": "^5.2.1",
    "content-type": "^1.0.5",
    "cors": "^2.8.6",
    "dotenv": "^18.0.4",
    "express": "^5.2.1",
    "helmet": "^8.3.0",
    "http-auth": "^4.2.1",
    "http-auth-passport": "^1.0.7",
    "passport": "^0.7.0",
    "passport-http-bearer": "^1.0.1",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.3",
    "stoppable": "^1.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jest": "^30.5.2",
    "prettier": "^3.9.10",
    "supertest": "^7.3.0"
  }
}
